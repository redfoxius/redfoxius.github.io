---
// A row of rhombuses inspired by Hutsul geometric ornament: the one decorative element on the site.
---
<div class="band" aria-hidden="true">
  <svg width="100%" height="14">
    <defs>
      <pattern id="vervechka" width="42" height="14" patternUnits="userSpaceOnUse">
        <path d="M7 0 L14 7 L7 14 L0 7 Z" fill="var(--madder)" />
        <path d="M21 3 L25 7 L21 11 L17 7 Z" fill="var(--ink)" />
        <path d="M35 0 L42 7 L35 14 L28 7 Z" fill="var(--ochre)" />
      </pattern>
    </defs>
    <rect width="100%" height="14" fill="url(#vervechka)" />
  </svg>
</div>

<style>
  .band { line-height: 0; }
  svg { display: block; }
</style>
